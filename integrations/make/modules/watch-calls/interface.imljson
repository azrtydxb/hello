[
  { "name": "id", "type": "text", "label": "Event ID", "help": "Unique and stable across Hello's retries: filter on it when an action must not run twice." },
  { "name": "type", "type": "text", "label": "Type" },
  { "name": "createdAt", "type": "date", "label": "Created at" },
  {
    "name": "data",
    "type": "collection",
    "label": "Call",
    "spec": [
      { "name": "callId", "type": "text", "label": "Call ID" },
      { "name": "direction", "type": "text", "label": "Direction" },
      { "name": "extension", "type": "text", "label": "Extension" },
      { "name": "from", "type": "collection", "label": "From", "spec": [{ "name": "number", "type": "text" }, { "name": "name", "type": "text" }, { "name": "extension", "type": "text" }] },
      { "name": "to", "type": "collection", "label": "To", "spec": [{ "name": "number", "type": "text" }, { "name": "name", "type": "text" }, { "name": "extension", "type": "text" }] },
      { "name": "durationMs", "type": "number", "label": "Duration (ms)" },
      { "name": "reason", "type": "text", "label": "Missed reason" },
      { "name": "cdrId", "type": "number", "label": "CDR ID" },
      { "name": "recordingId", "type": "number", "label": "Recording ID" }
    ]
  }
]
