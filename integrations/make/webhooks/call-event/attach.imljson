{
  "url": "/webhooks",
  "method": "POST",
  "body": {
    "name": "Make: {{scenario.name}}",
    "url": "{{webhook.url}}",
    "events": "{{parameters.events}}",
    "extensions": "{{ifempty(parameters.extensions; emptyarray)}}",
    "includePeer": "{{ifempty(parameters.includePeer; false)}}",
    "includeMessageBody": "{{ifempty(parameters.includeMessageBody; false)}}"
  },
  "response": {
    "temp": {
      "id": "{{body.id}}"
    }
  }
}
