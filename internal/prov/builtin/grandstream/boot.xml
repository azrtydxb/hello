<?xml version="1.0" encoding="UTF-8"?>
<!-- Kuvryn Hello bootstrap: no account and no server here, so it never overrides the hand-off. Hello CA certificate: {{xml .Prov.CAURL}} -->
<gs_provision version="1">
  <config version="1">
{{- with .Prov.CACertPEM}}
    <P8433>{{xml .}}</P8433>
{{- end}}
    <P194>1</P194>
    <P193>{{div .Prov.ResyncSeconds 60}}</P193>
  </config>
</gs_provision>
