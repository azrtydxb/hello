<?xml version="1.0" encoding="UTF-8"?>
<!-- Kuvryn Hello boot hand-off: no account here; this moves the phone to its own HTTPS URL. Hello CA certificate: {{xml .Prov.CAURL}} -->
<gs_provision version="1">
{{- with .Phone.MAC}}
  <mac>{{.}}</mac>
{{- end}}
  <config version="1">
    <P212>2</P212>
{{- with .Prov.CACertPEM}}
    <P8433>{{xml .}}</P8433>
{{- end}}
    <P237>{{xml .Prov.URL}}</P237>
    <P145>0</P145>
    <P194>1</P194>
    <P193>{{div .Prov.ResyncSeconds 60}}</P193>
  </config>
</gs_provision>
