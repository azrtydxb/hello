# The scheme the client used: an ingress in front (kw) terminates TLS and
# says so in X-Forwarded-Proto; without one it is this listener's own.
# hello-control marks session cookies Secure from it.
map $http_x_forwarded_proto $hello_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve the control plane's name at request time (valid=10s):
    # hello-control containers get new addresses when they are recreated,
    # and a name resolved once at startup would keep pointing at a dead one.
    resolver ${HELLO_DNS_RESOLVER} valid=10s ipv6=off;

    # The assistant's streamed answers (docs/ai-agent.md, "Streaming
    # answers"): POST .../messages with Accept: text/event-stream is an event
    # stream that must reach the browser as it is written. Nothing here or in
    # front of it may buffer it: no response buffering or caching, no
    # compression, X-Accel-Buffering for the ingress controller (nginx hides
    # that header of hello-control's, so it is set again), and a read timeout
    # above the model timeout; hello-control sends a keepalive comment every
    # 15 s, so the connection is never idle for long. The same location
    # answers the JSON call, which is unaffected.
    location ~ ^/api/v1/ai/sessions/[^/]+/messages$ {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering "no" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # The call-event stream (docs/integrations.md, "Call events"): GET
    # /api/v1/events/stream is a server-sent event stream that stays open for
    # hours. It must reach the client as it is written: no buffering, caching
    # or compression, X-Accel-Buffering for the ingress controller (nginx
    # hides that header of hello-control's), and a read timeout well above the
    # 15 s keepalive comment hello-control sends. Clients resume with
    # Last-Event-ID after any disconnect.
    location = /api/v1/events/stream {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering "no" always;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The inbox's live feed (docs/inbox.md, "Live updates"): GET
    # /api/v1/me/inbox/stream is a server-sent event stream that must reach
    # the browser as it is written, and stay open for hours: no buffering, no
    # caching, no compression, X-Accel-Buffering for an ingress controller in
    # front, and a read timeout far above hello-control's 15 s keepalive, so
    # an idle stream is never cut.
    location = /api/v1/me/inbox/stream {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering "no" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /api/ {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;

        # Firmware uploads (Phones -> Firmware) go up to 512 MB; nginx's
        # 1 MB default answers 413. Stream the body straight to
        # hello-control instead of spooling it, and give it time to land.
        client_max_body_size 520m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # External AI access (docs/ai-access.md): the MCP endpoint, the OAuth
    # authorization server and its well-known metadata are hello-control's.
    location = /mcp {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;
        # Streamable HTTP answers may be an event stream: pass it through.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /oauth/ {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;
    }

    location /.well-known/oauth- {
        set $hello_control ${HELLO_CONTROL_UPSTREAM};
        proxy_pass $hello_control;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $hello_forwarded_proto;
    }

    # The consent page is the console's own route, not the authorization
    # server's, and must never be framed (clickjacking a consent click).
    location = /oauth/consent {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        try_files /index.html =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
