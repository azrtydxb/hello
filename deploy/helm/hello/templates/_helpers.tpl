{{/* Name of a release's objects: the release name, with "hello" added when it is not in it. */}}
{{- define "hello.fullname" -}}
{{- if contains "hello" .Release.Name -}}
{{- .Release.Name | trunc 40 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-hello" .Release.Name | trunc 40 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}

{{/* The cluster DNS name of a Service: <name>.<namespace>.svc.<domain> */}}
{{- define "hello.svcFQDN" -}}
{{- printf "%s.%s.svc.%s" .name .root.Release.Namespace .root.Values.global.clusterDomain -}}
{{- end -}}

{{/* Selector labels of one component; the same set the kw manifests use. */}}
{{- define "hello.selectorLabels" -}}
app.kubernetes.io/name: hello
app.kubernetes.io/instance: {{ .root.Release.Name }}
app.kubernetes.io/component: {{ .component }}
{{- end -}}

{{- define "hello.labels" -}}
{{ include "hello.selectorLabels" . }}
app.kubernetes.io/managed-by: {{ .root.Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .root.Chart.Name .root.Chart.Version | replace "+" "_" }}
{{- end -}}

{{/* image: registry/name:tag. .tag overrides global.imageTag for one component. */}}
{{- define "hello.image" -}}
{{- $tag := default .root.Values.global.imageTag .tag -}}
{{- printf "%s/%s:%s" .root.Values.global.imageRegistry .name $tag -}}
{{- end -}}

{{- define "hello.pullSecrets" -}}
{{- with .Values.global.imagePullSecrets }}
imagePullSecrets:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- end -}}

{{- define "hello.secretName" -}}
{{- required "secrets.existingSecret is required: the name of a Secret holding dsn, secretKey, nonceSecret, bootstrapPassword, minioAccessKey and minioSecretKey" .Values.secrets.existingSecret -}}
{{- end -}}

{{/* One env var read from a Secret (the credentials Secret unless .secret is given). */}}
{{- define "hello.secretEnv" -}}
- name: {{ .env }}
  valueFrom:
    secretKeyRef:
      name: {{ default (include "hello.secretName" .root) .secret }}
      key: {{ .key }}
      {{- if .optional }}
      optional: true
      {{- end }}
{{- end -}}

{{/* PostgreSQL, Valkey, MinIO, application key and domain: shared by control, sip and the migrate init. */}}
{{- define "hello.commonEnv" -}}
{{ include "hello.secretEnv" (dict "root" . "env" "HELLO_DATABASE_URL" "key" "dsn") }}
{{ include "hello.valkeyEnv" . }}
- name: HELLO_SIP_DOMAIN
  value: {{ required "global.sipDomain is required" .Values.global.sipDomain | quote }}
{{ include "hello.secretEnv" (dict "root" . "env" "HELLO_SECRET_KEY" "key" "secretKey") }}
{{ include "hello.minioEnv" . }}
{{- end -}}

{{- define "hello.valkeyEnv" -}}
{{- $v := .Values.valkey -}}
{{- if $v.enabled -}}
- name: HELLO_VALKEY_ADDR
  value: {{ printf "%s-valkey:6379" (include "hello.fullname" .) | quote }}
{{- else if $v.external.sentinels -}}
- name: HELLO_VALKEY_SENTINELS
  value: {{ join "," $v.external.sentinels | quote }}
- name: HELLO_VALKEY_MASTER
  value: {{ required "valkey.external.master is required with valkey.external.sentinels" $v.external.master | quote }}
{{- else if $v.external.addr -}}
- name: HELLO_VALKEY_ADDR
  value: {{ $v.external.addr | quote }}
{{- else -}}
{{- fail "Valkey is neither bundled nor external: set valkey.enabled=true, or valkey.external.addr, or valkey.external.sentinels with valkey.external.master" -}}
{{- end -}}
{{- end -}}

{{- define "hello.minioEnv" -}}
{{- $m := .Values.minio -}}
- name: MINIO_ENDPOINT
  {{- if $m.enabled }}
  value: {{ printf "%s-minio:9000" (include "hello.fullname" .) | quote }}
  {{- else }}
  value: {{ required "MinIO is neither bundled nor external: set minio.enabled=true or minio.external.endpoint" $m.external.endpoint | quote }}
  {{- end }}
{{ include "hello.secretEnv" (dict "root" . "env" "MINIO_ACCESS_KEY" "key" "minioAccessKey") }}
{{ include "hello.secretEnv" (dict "root" . "env" "MINIO_SECRET_KEY" "key" "minioSecretKey") }}
- name: MINIO_SECURE
  value: {{ ternary "false" (toString $m.external.secure) $m.enabled | quote }}
{{- end -}}

{{/* Kamailio's dispatcher list, one line per hello-sip node. */}}
{{- define "hello.dispatcherList" -}}
{{- $full := include "hello.fullname" . -}}
# Generated by the Helm chart: set 1 is every hello-sip node, by the stable
# DNS name of its StatefulSet pod. Format: setid destination flags priority
# attributes. Flags 0: start active; probing keeps each destination's state.
{{- range $i := until (int .Values.sip.nodes) }}
{{- $pod := printf "%s-sip-%d" $full $i }}
1 sip:{{ include "hello.svcFQDN" (dict "root" $ "name" (printf "%s.%s-sip" $pod $full)) }}:5060 0 0 duid={{ $pod }}
{{- end }}
{{- end -}}

{{/* Soft hostname anti-affinity for a component. */}}
{{- define "hello.preferSpread" -}}
podAntiAffinity:
  preferredDuringSchedulingIgnoredDuringExecution:
    - weight: 100
      podAffinityTerm:
        topologyKey: kubernetes.io/hostname
        labelSelector:
          matchLabels:
            {{- include "hello.selectorLabels" . | nindent 12 }}
{{- end -}}

{{- define "hello.requireSpread" -}}
podAntiAffinity:
  requiredDuringSchedulingIgnoredDuringExecution:
    - topologyKey: kubernetes.io/hostname
      labelSelector:
        matchLabels:
          {{- include "hello.selectorLabels" . | nindent 10 }}
{{- end -}}

{{- define "hello.containerSecurity" -}}
allowPrivilegeEscalation: false
capabilities:
  drop:
    - ALL
{{- end -}}

{{/* Where phones reach Kamailio: the VIP with kamailio.vip.enabled, else kamailio.publicHost. */}}
{{- define "hello.kamailioPublicHost" -}}
{{- $k := .Values.kamailio -}}
{{- if $k.vip.enabled -}}
{{- $addr := required "kamailio.vip.address is required with kamailio.vip.enabled: the virtual IP phones use" $k.vip.address -}}
{{- if and $k.publicHost (ne $k.publicHost $addr) -}}
{{- fail (printf "kamailio.publicHost %q differs from kamailio.vip.address %q: with a VIP, phones are told to use the VIP; leave publicHost empty" $k.publicHost $addr) -}}
{{- end -}}
{{- $addr -}}
{{- else -}}
{{- required "kamailio.publicHost is required: the address phones reach Kamailio at" $k.publicHost -}}
{{- end -}}
{{- end -}}
